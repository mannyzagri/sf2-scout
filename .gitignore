build/
build-*/
# libopenmpt's common/version.cpp includes ../build/svn_version/svn_version.h: that
# vendored file must be tracked although it lives under a directory named build/.
!third_party/libopenmpt/libopenmpt-0.8.9/build/
deps/
scratch/
*.exe
*.obj
*.vst3/
.validator/
.DS_Store

# Claude skills + agents are junctions into C:/code-bank (canonical there),
# created by C:\code-bank\tools\bootstrap-project.ps1 -- never commit copies.
.claude/skills/
.claude/agents/

# Third-party SoundFonts are the user's; never commit one (docs/DSP.md NON-features).
*.sf2
*.sf3
*.SF2

# build agent log
build_output.log
# v2: tracker modules and SF2s are the operator's material, never committed
*.mod
*.xm
*.it
*.s3m
