{
  "_readme": "Canonical validator config for sf2-scout (repo root wins over code-bank/validator/configs exports). No `gui` stage: the face is plain JUCE, not WebView (CLAUDE.md D-1) -- the headless-Chrome checks do not apply and are omitted rather than faked. `handoff` points at the DERIVED manifest vm-claude wrote from the v1 bundle; gui-claude has been asked for a native one.",
  "schema": 1,
  "project": "sf2-scout",
  "srcExport": "C:\\vagrant\\Projects\\sf2-scout\\sf2-scout-src",

  "handoff": {
    "manifest": "docs\\handoff-gui-v1\\handoff-manifest.json",
    "root": "docs\\handoff-gui-v1",
    "spec": { "file": "docs\\handoff-gui-v1\\handoff-manifest.json", "block": "sf2scout-params" },
    "guiPage": "main"
  },

  "dsp": {
    "harnesses": [
      {
        "name": "test_engine",
        "compile": "cl /nologo /EHsc /O2 /std:c++17 /W3 tests\\test_engine.cpp Source\\engine\\SoundFontBank.cpp Source\\engine\\ScoutEngine.cpp /Fo:scratch\\ /Fe:scratch\\test_engine.exe",
        "run": "scratch\\test_engine.exe",
        "expect": ["[load]", "[authored]", "[looponly]", "[pitch]", "[release]", "[malformed]", "[swap]", "checks: 58, failed: 0", "ALL CHECKS PASSED"]
      }
    ]
  },

  "bundle": {
    "built": "build\\Sf2Scout_artefacts\\Release\\VST3\\SF2 Scout.vst3",
    "versionFrom": { "file": "CMakeLists.txt", "regex": "project\\(Sf2Scout VERSION ([0-9.]+)" },
    "sources": ["Source", "CMakeLists.txt", "third_party"],
    "require": [],
    "forbid": [],
    "build": {
      "configure": "cmake -B build -S . -G \"Visual Studio 17 2022\" -A x64 -D FETCHCONTENT_SOURCE_DIR_JUCE=C:/rhino/deps/JUCE",
      "build": "cmake --build build --config Release --target Sf2Scout_VST3 --parallel"
    }
  },

  "deploy": {
    "targets": ["C:\\sf2-scout\\SF2 Scout.vst3", "\\\\VBOXSVR\\vagrant\\Builds\\SF2 Scout.vst3"]
  },

  "host": { "pluginval": { "strictness": 5 } }
}
